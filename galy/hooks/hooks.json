{
  "description": "Galy — hold the door on the one file every session pays for.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-md-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
